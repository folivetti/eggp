packages: .
         ../srtree

allow-newer: *

package srtree
  ghc-options: -fllvm -pgmlo opt-20 -pgmlc llc-20 -optlo-O3 -optlc-mcpu=native -mavx2 -mfma -fexpose-all-unfoldings

source-repository-package
    type: git
    location: https://github.com/haskell/mwc-random
    tag: 2cce257158befe52417433d1e7717f11ce718aec

if os(darwin)
    package *
      extra-include-dirs: /opt/homebrew/include
      extra-lib-dirs: /opt/homebrew/lib
